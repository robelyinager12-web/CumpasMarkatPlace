# Copy values into apps/api/.env and apps/web/.env.local (never commit real secrets)

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Backend (apps/api/.env) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/unikamp
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_secure_random_secret

# Configure only when these services are implemented
EMAIL_API_KEY=
IMAGE_STORAGE_URL=
IMAGE_STORAGE_KEY=

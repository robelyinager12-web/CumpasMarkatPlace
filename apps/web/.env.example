# Local: the browser calls the API directly
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (Vercel): browser calls /api/v1 on the same domain, Next.js proxies to the API
# NEXT_PUBLIC_API_URL=/api/v1
# API_INTERNAL_URL=https://YOUR-API-HOST/api/v1

# Shown on the Contact, Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/unikamp
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional tuning
BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX=50

# Email: leave EMAIL_API_KEY empty in development (links are printed in the API terminal)
EMAIL_API_KEY=
EMAIL_FROM="UniKamp <onboarding@resend.dev>"

# Images: "local" saves files in apps/api/uploads (development only).
# Production must use cloudinary: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
IMAGE_STORAGE_DRIVER=local
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_URL=
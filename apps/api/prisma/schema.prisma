generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
  REMOVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model University {
  id        String    @id @default(cuid())
  name      String    @unique
  city      String?
  isActive  Boolean   @default(true)
  campuses  Campus[]
  users     User[]
  products  Product[]
  createdAt DateTime  @default(now())
}

model Campus {
  id           String     @id @default(cuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  users        User[]
  products     Product[]

  @@unique([universityId, name])
}

model User {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  phone         String?       @unique
  passwordHash  String
  role          Role          @default(STUDENT)
  status        AccountStatus @default(ACTIVE)
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  department    String?
  universityId  String
  campusId      String?
  university    University    @relation(fields: [universityId], references: [id])
  campus        Campus?       @relation(fields: [campusId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // two-factor sign-in (Phase 6)
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  recoveryCodeHashes String[] @default([])

  verification   StudentVerification?
  products       Product[]
  favorites      Favorite[]
  messages       Message[]
  conversations  ConversationParticipant[]
  reportsFiled   ListingReport[]           @relation("ReportFiler")
  reportsAgainst ListingReport[]           @relation("ReportedUser")
  blocksMade     UserBlock[]               @relation("Blocker")
  blocksReceived UserBlock[]               @relation("Blocked")
  notifications  Notification[]
  auditLogs      AuditLog[]
  sessions       Session[]
  authTokens     AuthToken[]
}

model StudentVerification {
  id          String             @id @default(cuid())
  userId      String             @unique
  status      VerificationStatus @default(UNVERIFIED)
  reviewedBy  String?
  note        String?
  requestNote String?
  requestedAt DateTime?
  reviewedAt  DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id           String            @id @default(cuid())
  title        String
  description  String
  priceEtb     Decimal           @db.Decimal(12, 2)
  negotiable   Boolean           @default(false)
  quantity     Int               @default(1)
  condition    ProductCondition
  status       ListingStatus     @default(ACTIVE)
  isDemo       Boolean           @default(false)
  sellerId     String
  categoryId   String
  universityId String
  campusId     String?
  seller       User              @relation(fields: [sellerId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  university   University        @relation(fields: [universityId], references: [id])
  campus       Campus?           @relation(fields: [campusId], references: [id])
  images       ProductImage[]
  favorites    Favorite[]
  reports      ListingReport[]
  views        ListingView[]
  featured     FeaturedListing[]
  conversations Conversation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([universityId, campusId])
  @@index([priceEtb])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Conversation {
  id            String                    @id @default(cuid())
  productId     String
  dedupeKey     String                    @unique // "<productId>:<buyerId>" gives one conversation per buyer per listing
  lastMessageAt DateTime                  @default(now())
  product       Product                   @relation(fields: [productId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]
  createdAt     DateTime                  @default(now())

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model ListingReport {
  id             String       @id @default(cuid())
  productId      String?
  reportedUserId String?
  reporterId     String
  reason         String
  details        String?
  status         ReportStatus @default(PENDING)
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Restrict)
  reporter       User         @relation("ReportFiler", fields: [reporterId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([productId])
  @@index([reportedUserId])
  @@index([reporterId])
}

model ListingView {
  id        String   @id @default(cuid())
  productId String
  viewerId  String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// Data structure only: payments are NOT implemented in v1
model FeaturedListing {
  id        String   @id @default(cuid())
  productId String
  startsAt  DateTime
  endsAt    DateTime
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([endsAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  body      String
  link      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Failed sign-in counters, keyed by a hash so no email address is stored (Phase 6)
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}